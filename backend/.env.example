# Settlex Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# ==================== REQUIRED ====================
# Gemini AI API Key for LLM negotiation
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Specify Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ==================== STELLAR CONFIGURATION ====================
# Stellar network (testnet or public)
STELLAR_NETWORK=TESTNET

# Optional: Stellar secret key for agent wallet (auto-generated if not provided)
# WARNING: Never commit this to version control
STELLAR_SECRET_KEY=

# ==================== CORS SECURITY ====================
# Comma-separated list of allowed origins for CORS
# Default: http://localhost:5173,http://localhost:3000
# Example for production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ==================== DATABASE & PASSKEYS (WOW FEATURES) ====================
# SQLite (default: backend/.data/settlex.db)
# DATABASE_URL=sqlite:///./.data/settlex.db

# Passkeys / WebAuthn (defaults from the browser Origin header)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:5173

# ==================== STELLAR / ANCHOR DISCOVERY ====================
# Optional: override Horizon (defaults to testnet or public from STELLAR_NETWORK)
# HORIZON_URL=https://horizon-testnet.stellar.org

# Optional: asset used for SEP-1 issuer → home_domain discovery (defaults to testnet USDC)
# ASSET_CODE=USDC
# ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Optional: skip issuer discovery and use testanchor.stellar.org (native XLM also does this)
# ANCHOR_MODE=testing
# SETTLEX_STRICT_TESTING=true

# TRY fiat rail: Turkish TRY <-> USDC SEP-6 anchor (testnet, simulated bank leg).
# The testnet USDC issuer's home_domain (centre.io) has no TRANSFER_SERVER, so pin the anchor here.
# Remove it to fall back to issuer discovery / testanchor.stellar.org.
ANCHOR_HOME=tr-mock-anchor.fly.dev

# Friendbot configuration (default: https://friendbot.stellar.org)
# FRIENDBOT_URL=https://friendbot.stellar.org