# Kasa AI Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# ==================== REQUIRED ====================
# Gemini AI API Key for LLM negotiation
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Specify Gemini model (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# ==================== STELLAR CONFIGURATION ====================
# Stellar network (testnet or public)
STELLAR_NETWORK=TESTNET

# Optional: Stellar secret key for agent wallet (auto-generated if not provided)
# WARNING: Never commit this to version control
STELLAR_SECRET_KEY=

# ==================== CORS SECURITY ====================
# Comma-separated list of allowed origins for CORS
# Default: http://localhost:5173,http://localhost:3000
# Example for production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== OPTIONAL ====================
# Anchor configuration (default: tr-mock-anchor.fly.dev)
# ANCHOR_HOME=https://tr-mock-anchor.fly.dev

# Horizon configuration (default: https://horizon-testnet.stellar.org)
# HORIZON_URL=https://horizon-testnet.stellar.org

# Friendbot configuration (default: https://friendbot.stellar.org)
# FRIENDBOT_URL=https://friendbot.stellar.org
